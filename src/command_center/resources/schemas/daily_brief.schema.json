{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chief of Staff Daily Brief (\u00a717, Part 19)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_date",
    "organization_id",
    "agent_id",
    "executive_summary",
    "business_health",
    "revenue",
    "cash",
    "pipeline",
    "operations",
    "customers",
    "costs",
    "risk",
    "todays_priorities",
    "decisions_required",
    "ai_actions_in_progress",
    "watchlist",
    "sources"
  ],
  "properties": {
    "brief_date": {
      "type": "string",
      "format": "date"
    },
    "organization_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1
    },
    "business_health": {
      "$ref": "#/$defs/health"
    },
    "revenue": {
      "$ref": "#/$defs/section"
    },
    "cash": {
      "$ref": "#/$defs/section"
    },
    "pipeline": {
      "$ref": "#/$defs/section"
    },
    "operations": {
      "$ref": "#/$defs/section"
    },
    "customers": {
      "$ref": "#/$defs/section"
    },
    "costs": {
      "$ref": "#/$defs/section"
    },
    "risk": {
      "$ref": "#/$defs/section"
    },
    "todays_priorities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/priority"
      },
      "maxItems": 7
    },
    "decisions_required": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "ai_actions_in_progress": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "watchlist": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/watch"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "data_quality": {
      "$ref": "#/$defs/data_quality"
    }
  },
  "$defs": {
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "components"
      ],
      "properties": {
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "null when inputs are insufficient; never guessed"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "summary"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "GREEN",
                  "AMBER",
                  "RED",
                  "UNKNOWN"
                ]
              },
              "score": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "summary": {
                "type": "string"
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "items"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "FACT",
                  "INFERENCE",
                  "ASSUMPTION"
                ]
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "data_available": {
          "type": "boolean"
        }
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "why_it_matters",
        "owner",
        "source_agent",
        "urgency",
        "expected_impact",
        "deadline",
        "status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string"
        },
        "source_agent": {
          "type": "string"
        },
        "urgency": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "expected_impact": {
          "type": "string"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "BLOCKED",
            "DONE"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "context",
        "options",
        "decision_owner"
      ],
      "properties": {
        "decision": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_option": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_owner": {
          "type": "string"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "description",
        "status"
      ],
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "TOOL_WAIT",
            "APPROVAL_REQUIRED"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "reason"
      ],
      "properties": {
        "item": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "trigger_to_escalate": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "reference"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string"
        },
        "authority_level": {
          "enum": [
            "AUTHORITATIVE",
            "SECONDARY",
            "UNVERIFIED"
          ]
        }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_status",
        "stale_sources",
        "missing_sources",
        "conflicting_sources",
        "unverified_metrics",
        "notes"
      ],
      "properties": {
        "overall_status": {
          "enum": [
            "GOOD",
            "DEGRADED",
            "POOR",
            "UNKNOWN"
          ]
        },
        "stale_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "last_updated"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "last_updated": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "expected_freshness": {
                "type": "string"
              }
            }
          }
        },
        "missing_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicting_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "source_ids",
              "description"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "unverified_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
